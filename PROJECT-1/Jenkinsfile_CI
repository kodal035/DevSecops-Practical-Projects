pipeline {
    agent any

    tools {
        nodejs 'nodejs23'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {
        stage('Git Checkout') {
            steps {
                checkout scmGit(branches: [[name: 'main']], extensions: [], userRemoteConfigs: [[credentialsId: 'github-token', url: 'https://github.com/kodal035/DevSecops-Practical-Projects.git']])
            }
        }

        stage('Frontend Compilation') {
            steps {
                dir('PROJECT-1/client') {
                    sh 'find . -name "*.js" -exec node --check {} +'
                }
            }
        }

        stage('Backend Compilation') {
            steps {
                dir('PROJECT-1/api') {
                    sh 'find . -name "*.js" -exec node --check {} +'
                }
            }
        }

        stage('Gitleaks Scan') {
            steps {
                sh 'gitleaks detect --source ./PROJECT-1/client --exit-code 1'
                sh 'gitleaks detect --source ./PROJECT-1/api --exit-code 1'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar-projectName-Nodejs-Project \
                            -Dsonar.projectKey=Nodejs-Project'''
                }
            }
        }

        stage('Quality Gate Check') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh 'trivy fs --format table -o fs-report.html .'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    cd PROJECT-1/api
                    npm install
                '''
                sh '''
                    cd PROJECT-1/client
                    npm install
                '''
            }
        }

        stage('Run Application') {
            steps {
                sh '''
                    cd PROJECT-1/api
                    nohup npm start > api.log 2>&1 &
                '''
                sh '''
                    cd PROJECT-1/client
                    nohup npm start > client.log 2>&1 &
                '''
            }
        }
    }
}
